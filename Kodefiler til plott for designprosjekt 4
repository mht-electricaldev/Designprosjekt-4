import numpy as np
import matplotlib.pyplot as plt
import csv
header = []
data = []
filename = 'NonLinearScope.csv'
with open(filename) as csvfile:
    csvreader = csv.reader(csvfile)
    header = next(csvreader)
    for datapoint in csvreader:
        values = [float(value) for value in datapoint]
        data.append(values)
time = [(p[0]) for p in data]
ch1 = [(p[1]) for p in data]
ch2 = [(p[2]) for p in data]

m = 10**6
time = [i * m for i in time]

print("ch2 max: ",np.max(ch2))

plt.plot(time, ch1, label= "$x_1$(t)")
plt.plot(time, ch2, label= "$y(t)$")
plt.title("Oscilloskop av $x_1$(t) og y(t)")
plt.xlabel("tid $\mu$s")
plt.legend(loc= 'upper right')
plt.ylabel("Spenning [V]")
plt.yticks([-1, -0.5, -0.15, 0, 0.15, 0.5, 1])
plt.grid(True)
plt.savefig('UlineartSystemRealisertScope')

