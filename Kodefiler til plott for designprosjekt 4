import matplotlib.pyplot as plt
import numpy as np

x_i = np.linspace(-0.0003,0.00015,2000)

def sin_f(x):
    return 5*np.sin(2*np.pi*3525*x)

def ulineærOppførsel(x):
    y_verdier = []
    baseLine = sin_f(x)
    for i in baseLine:
        if i >= 0.7:
            y_verdier.append(i - 0.7)
        else:
            y_verdier.append(0)
    return y_verdier

xVerdier = x_i
y1Verdier = sin_f(xVerdier)
ulineærVerdi = ulineærOppførsel(xVerdier)

m = 10**6
xVerdier = [i * m for i in xVerdier]
    
plt.plot(xVerdier,y1Verdier, label='$x_1(t)$')
plt.plot(xVerdier,ulineærVerdi, label='y(t)')
plt.title("Eksempel på oppførsel til signalet over $x_1(t)$ og $y(t)$", fontsize=16)
plt.xlabel("Tid($\mu$s)", fontsize=14)
plt.ylabel("Spenning(V)", fontsize=14)
plt.legend()
plt.savefig('Ulineært system oppførsel')

