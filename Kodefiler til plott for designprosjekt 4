import matplotlib.pyplot as plt
import numpy as np

def sin_f(x):
    return np.sin(x)

def sin_2f(x):
    return 0.5*np.sin(2*x)

xVerdier = np.linspace(0,6*np.pi,1000)
y1Verdier = sin_f(xVerdier)
y2Verdier = sin_2f(xVerdier)

plt.plot(xVerdier,y1Verdier, label='$x_1(t)$', color = "C1")
plt.plot(xVerdier,y2Verdier, label='$\widehat{x_2}(t)$', color = "C0")
plt.title("Oscilloskop over $x_1(t)$ og $\widehat{x_2}(t)$", fontsize=16)
plt.xlabel("Tid(s)", fontsize=14)
plt.ylabel("Spenning(V)", fontsize=14)
plt.legend(borderpad = 1.3, fontsize=14)
plt.savefig('problembeskrivelse.png')

